# Copy to .env and fill in. Never commit .env.

# atlas-local from `make up`:
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
# Atlas free cluster (demo only; never for tests). Use with: MONGODB_URI=$MONGODB_URI_ATLAS make initdb
MONGODB_URI_ATLAS=

GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
