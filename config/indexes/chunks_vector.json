{
  "name": "chunks_vector",
  "type": "vectorSearch",
  "definition": {
    "fields": [
      {
        "type": "vector",
        "path": "embedding",
        "numDimensions": "{embedding.dim}",
        "similarity": "cosine",
        "quantization": "{embedding.quantization}"
      },
      {"type": "filter", "path": "owner_id"},
      {"type": "filter", "path": "doc_id"}
    ]
  }
}
